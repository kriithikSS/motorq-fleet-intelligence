# ── Motorq Hackathon — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git!

# ── PostgreSQL / TimescaleDB ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=motorq
POSTGRES_USER=motorq
POSTGRES_PASSWORD=motorq_secret
DATABASE_URL=postgresql://motorq:motorq_secret@localhost:5432/motorq

# ── MongoDB ───────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=motorq
MONGO_PASSWORD=motorq_secret
MONGO_DB=telemetry
MONGO_URI=mongodb://motorq:motorq_secret@localhost:27017/telemetry?authSource=admin

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=motorq_secret
REDIS_URL=redis://:motorq_secret@localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_GROUP_ID=motorq-consumer-group

# ── Elasticsearch ─────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=motorq

# ── Qdrant (Vector Store) ─────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_ALERTS=motorq-alerts
QDRANT_COLLECTION_TRIPS=motorq-trips

# ── MQTT (EMQX) ───────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Auth (OAuth2 / OIDC) ──────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
OAUTH2_PROVIDER_URL=http://localhost:8484/realms/motorq
OAUTH2_CLIENT_ID=motorq-api
OAUTH2_CLIENT_SECRET=CHANGE_ME

# ── LLM / Agent ───────────────────────────────────────────────────
# Set one of the below; agent will use whichever is set
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o          # or: claude-3-5-sonnet, gemini-2.0-flash
LLM_PROVIDER=openai        # or: anthropic, google

# ── Observability ─────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── API Gateway ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000

# ── Data Simulator ────────────────────────────────────────────────
SIMULATOR_NUM_VEHICLES=100000
SIMULATOR_EVENTS_PER_SECOND=100000
SIMULATOR_FAULT_RATE=0.02        # 2% of vehicles have a fault at any time
SIMULATOR_BURST_MULTIPLIER=3     # 3x burst at shift start

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
